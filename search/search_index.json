{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#bond-university","title":"\u6fb3\u5927\u5229\u4e9a\u90a6\u5fb7\u5927\u5b66\uff08Bond University\uff09\u5b66\u4f4d\u8bc1\u4e66\u6837\u5f0f\u7279\u5f81\u53ca\u56fd\u5883\u5b66\u4f4d\u5408\u89c4\u5316\u6838\u9a8c\u6307\u5357","text":"<p>\u5728\u4e2d\u56fd\u4f01\u4e1a\u51fa\u6d77\u62db\u5546\u3001\u8de8\u56fd\u4eba\u624d\u5f15\u8fdb\u4ee5\u53ca\u7559\u5b66\u751f\u56de\u56fd\u843d\u6237\u7684\u6f6e\u6c50\u4e2d\uff0c\u5982\u4f55\u7cbe\u51c6\u3001\u9ad8\u6548\u5730\u9274\u522b\u6d77\u5916\u6587\u51ed\u7684\u771f\u5b9e\u6027\uff0c\u5e76\u5b8c\u6210\u5408\u89c4\u5316\u51c6\u5165\uff0c\u6210\u4e3aHR\u4e0e\u6d77\u5f52\u5b66\u5b50\u5171\u540c\u77a9\u76ee\u7684\u7126\u70b9\u3002\u4f5c\u4e3a\u6fb3\u5927\u5229\u4e9a\u9996\u6240\u79c1\u7acb\u975e\u8425\u5229\u6027\u83c1\u82f1\u5b66\u5e9c\uff0c\u90a6\u5fb7\u5927\u5b66\uff08Bond University\uff09\u56e0\u5176\u9ad8\u5bc6\u5ea6\u7684\u5b66\u5236\u4e0e\u5f3a\u52b2\u7684\u5c31\u4e1a\u7ade\u4e89\u529b\u5907\u53d7\u4e2d\u56fd\u5b66\u5b50\u9752\u7750\u3002</p> <p></p> <p>\u672c\u6587\u5c06\u57fa\u4e8e\u6700\u65b0\u7684\u90a6\u5fb7\u5927\u5b66\u5b98\u65b9\u6837\u672c\uff0c\u6df1\u5ea6\u62c6\u89e3\u5176\u5b66\u4f4d\u8bc1\u4e66\uff08Testamur\uff09\u7684\u89c6\u89c9\u7279\u5f81\u4e0e\u7269\u7406\u9632\u4f2a\u5de5\u827a\uff0c\u5e76\u7ed3\u5408\u5168\u7403\u6570\u5b57\u5316\u8d8b\u52bf\uff0c\u4e3a\u60a8\u5949\u4e0a\u517c\u5177\u6743\u5a01\u6027\u4e0e\u5b9e\u64cd\u6027\u7684\u56fd\u5883\u5b66\u4f4d\u5408\u89c4\u5316\u6838\u9a8c\u6307\u5357\u3002</p>"},{"location":"#testamur","title":"\u4e00\u3001 \u90a6\u5fb7\u5927\u5b66\u5b66\u4f4d\u8bc1\u4e66\uff08Testamur\uff09\u6838\u5fc3\u6837\u5f0f\u7279\u5f81\u4e0e\u9632\u4f2a\u6392\u7248\u62c6\u89e3","text":"<p>\u4e00\u4efd\u771f\u5b9e\u7684\u6fb3\u5927\u5229\u4e9a\u90a6\u5fb7\u5927\u5b66\u7eb8\u8d28\u6216\u5b98\u65b9PDF\u5b66\u4f4d\u8bc1\u4e66\uff0c\u5176\u6392\u7248\u3001\u5b57\u4f53\u53ca\u7279\u79cd\u5370\u5237\u5de5\u827a\u5747\u6709\u7740\u4e25\u82db\u7684\u5b66\u672f\u89c4\u8303\u3002\u901a\u8fc7\u5bf9\u6807\u51c6\u8bc1\u4e66\u7684\u89c6\u89c9\u52a8\u7ebf\u8fdb\u884c\u89e3\u6784\uff0c\u5176\u6838\u5fc3\u7279\u5f81\u53ef\u5f52\u7eb3\u4e3a\u4ee5\u4e0b\u4e94\u4e2a\u7ef4\u5ea6\uff1a</p>"},{"location":"#1","title":"1. \u9876\u90e8\u54c1\u724c\u57df\uff1a\u53cc\u8272\u6807\u51c6\u6821\u540d","text":"<p>\u8bc1\u4e66\u6b63\u4e0a\u65b9\u5c45\u4e2d\u4e66\u5199\u5927\u5b66\u6cd5\u5b9a\u540d\u79f0 \u201cBOND UNIVERSITY\u201d\u3002\u8be5\u6587\u5b57\u901a\u5e38\u91c7\u7528\u90a6\u5fb7\u5927\u5b66\u5b98\u65b9\u6807\u51c6\u8272\u2014\u2014\u90a6\u5fb7\u84dd\uff08Bond Navy\uff09\u8fdb\u884c\u5370\u5237\u3002\u5b57\u4f53\u7ecf\u8fc7\u7cbe\u7ec6\u62c9\u4f38\uff0c\u5b57\u95f4\u8ddd\u5bbd\u9614\uff0c\u5448\u73b0\u51fa\u5e84\u91cd\u800c\u73b0\u4ee3\u7684\u89c6\u89c9\u89c2\u611f\uff0c\u7edd\u975e\u7c97\u7cd9\u7684\u65e0\u886c\u7ebf\u6216\u7cfb\u7edf\u81ea\u5e26\u5b57\u4f53\u3002</p>"},{"location":"#2-crest","title":"2. \u4e2d\u592e\u89c6\u89c9\u6838\u5fc3\uff1a\u9ad8\u7cbe\u5f69\u8272\u76fe\u5fbd\uff08Crest\uff09","text":"<p>\u4f4d\u4e8e\u6821\u540d\u6b63\u4e0b\u65b9\u7684\u662f\u90a6\u5fb7\u5927\u5b66\u7684\u5b8c\u6574\u7eb9\u7ae0\uff08Coat of Arms\uff09\u3002 * \u56fe\u6848\u6784\u6210\uff1a \u5305\u542b\u4e86\u6838\u5fc3\u7684\u7ea2\u84dd\u76fe\u724c\u3001\u91d1\u8272\u592a\u9633\u3001\u5c55\u5f00\u7684\u5b66\u672f\u5178\u7c4d\u4ee5\u53ca\u73af\u7ed5\u7684\u91d1\u8272\u88c5\u9970\u3002 * \u5e95\u90e8\u7ef6\u5e26\uff1a \u7eb9\u7ae0\u5e95\u90e8\u7684\u7ef6\u5e26\u5185\u7528\u5927\u5199\u62c9\u4e01\u6587\u6216\u82f1\u6587\u6807\u6ce8\u7740\u90a6\u5fb7\u5927\u5b66\u7684\u6838\u5fc3\u6821\u8bad\uff1a\u201cFOREVER LEARNING\u201d\uff08\u5b66\u65e0\u6b62\u5883\uff09\u3002 * \u7269\u7406\u5de5\u827a\uff1a \u5728\u5b98\u65b9\u9881\u53d1\u7684\u5b9e\u4f53\u7eb8\u8d28\u6587\u51ed\u4e2d\uff0c\u6b64\u5904\u7684\u6821\u5fbd\u591a\u91c7\u7528\u9ad8\u7cbe\u5ea6\u6d6e\u96d5\u70eb\u91d1\u6216\u91cd\u8d28\u6cb9\u58a8\u53e0\u5370\u5de5\u827a\uff0c\u5e26\u6709\u8f7b\u5fae\u7684\u89e6\u89c9\u51f9\u51f8\u611f\uff0c\u8fb9\u7f18\u6781\u5ea6\u6e05\u6670\uff0c\u65e0\u4efb\u4f55\u6655\u67d3\u6216\u6bdb\u523a\u3002</p>"},{"location":"#3","title":"3. \u6b63\u6587\u6388\u6743\u4e66\u5199\uff1a\u5b66\u672f\u89c4\u8303\u6587\u672c","text":"<p>\u6b63\u6587\u90e8\u5206\u91c7\u7528\u7ecf\u5178\u7684\u82f1\u7f8e\u5b66\u672f\u6388\u8bcd\u683c\u5f0f\uff0c\u6392\u7248\u591a\u4f7f\u7528\u5bcc\u6709\u53e4\u5178\u5b66\u672f\u6c14\u606f\u7684\u886c\u7ebf\u659c\u4f53\u5b57\uff1a * \u6807\u51c6\u5f00\u7bc7\u8bed\uff1a \u201cThis is to certify that [\u6bd5\u4e1a\u751f\u6cd5\u5b9a\u59d3\u540d]... On the authority of the Council of Bond University...\u201d \u8bc1\u660e\u8be5\u5b66\u4f4d\u7ecf\u7531\u5927\u5b66\u6821\u8463\u4e8b\u4f1a\u6b63\u5f0f\u6388\u6743\u9881\u53d1\u3002 * \u4e13\u4e1a\u4e0e\u5b66\u4f4d\u52a0\u7c97\uff1a \u88ab\u6388\u4e88\u7684\u5b66\u4f4d\u540d\u79f0\uff08\u5982 MASTER OF SPORT MANAGEMENT (PROFESSIONAL)\uff09\u4f1a\u91c7\u7528\u5927\u5199\u3001\u52a0\u7c97\u7684\u9ed1\u4f53\u6216\u7279\u5236\u886c\u7ebf\u4f53\u5355\u72ec\u5217\u4e3a\u4e00\u884c\uff0c\u89c6\u89c9\u51b2\u51fb\u529b\u6781\u5f3a\u3002 * \u843d\u6b3e\u65e5\u671f\uff1a \u660e\u786e\u8bb0\u8f7d\u8bc1\u4e66\u7684\u6cd5\u5b9a\u6388\u4e88\u65f6\u95f4\uff0c\u901a\u5e38\u4f7f\u7528\u82f1\u6587\u5e8f\u6570\u8bcd\u624b\u5199\u4f53\u683c\u5f0f\uff08\u4f8b\u5982\uff1athis fifth day of October 2023\uff09\u3002</p>"},{"location":"#4","title":"4. \u5e95\u90e8\u8ba4\u8bc1\u57df\uff1a\u53cc\u91cd\u5370\u9274\u4e0e\u9ad8\u7ea7\u9632\u4f2a\u6807","text":"<p>\u8bc1\u4e66\u5e95\u90e8\u662f\u5224\u522b\u5176\u771f\u5b9e\u6027\u7684\u5173\u952e\u533a\u57df\uff0c\u5305\u542b\u4e86\u6cd5\u5f8b\u5c42\u9762\u7684\u53cc\u91cd\u4fdd\u969c\uff1a * \u5de6\u4e0b\u89d2\u706b\u6f06\u94a2\u5370\uff08Common Seal\uff09\uff1a \u5370\u6709\u5927\u7ea2\u8272\u7684\u9f7f\u8f6e\u72b6\u706b\u6f06\u8d34\u7eb8\uff0c\u5176\u4e0a\u6df1\u538b\u6709\u90a6\u5fb7\u5927\u5b66\u7684\u5fae\u7f29\u6821\u5fbd\u53ca \u201cBOND UNIVERSITY - FOREVER LEARNING\u201d \u5b57\u6837\u3002\u5b9e\u4f53\u8bc1\u4e66\u7684\u94a2\u5370\u5177\u6709\u5f3a\u70c8\u7684\u7269\u7406\u51f9\u9677\u75d5\u8ff9\u3002 * \u4e2d\u4e0b\u90e8\u5b98\u65b9\u7b7e\u7f72\uff1a \u5305\u542b\u6821\u957f\uff08CHANCELLOR\uff09\u4e0e\u526f\u6821\u957f\uff08VICE CHANCELLOR\uff09\u7684\u6cd5\u5b9a\u624b\u5199\u7b7e\u540d\u3002\u73b0\u4ee3\u7248\u672c\u591a\u91c7\u7528\u9ad8\u7cbe\u5236\u7248\u5370\u5237\u7b7e\u540d\uff0c\u4f46\u7ebf\u6761\u8fb9\u7f18\u5706\u6da6\u5e73\u6ed1\u3002 * \u53f3\u4e0b\u89d2\u5168\u606f\u9632\u4f2a\u6807\u7b7e\uff08Hologram\uff09\uff1a \u8fd9\u662f\u9632\u8303\u590d\u5370\u4ef6\u4f2a\u9020\u7684\u6838\u5fc3\u5c4f\u969c\u3002\u6807\u7b7e\u5728\u5149\u7ebf\u6298\u5c04\u4e0b\u4f1a\u663e\u73b0\u51fa\u6e10\u53d8\u7684\u4e03\u5f69\u5149\u6cfd\uff0c\u5185\u90e8\u5d4c\u5165\u4e86\u5fae\u7f29\u7684\u5b66\u6821\u5efa\u7b51\u3001\u6821\u5fbd\u56fe\u6848\u4ee5\u53ca\u591a\u5c42\u6b21\u7684\u6570\u5b57\u5316\u9632\u4f2a\u7f51\u7eb9\u3002</p>"},{"location":"#5","title":"5. \u9875\u811a\u8fb9\u9645\u7ebf\uff1a\u6570\u5b57\u53ef\u6eaf\u6e90\u7801","text":"<p>\u5728\u8bc1\u4e66\u7684\u6700\u5de6\u4e0b\u89d2\uff0c\u4f1a\u5782\u76f4\u6216\u6c34\u5e73\u6253\u5370\u4e00\u6392\u5fae\u5c0f\u7684\u6587\u5b57\uff0c\u5176\u4e2d\u5305\u62ec\u6bd5\u4e1a\u751f\u7684\u5b66\u751fID\uff08SID: XXXXXXXX\uff09\u4ee5\u53ca\u4e00\u6392\u7cfb\u7edf\u968f\u673a\u751f\u6210\u7684\u6570\u5b57\u9632\u4f2a\u5e8f\u5217\u53f7\u3002\u540c\u65f6\uff0c\u9875\u811a\u8fd8\u4f1a\u9644\u6709\u4e00\u884c\u6781\u7ec6\u7684\u5b98\u65b9\u514d\u8d23\u4e0e\u67e5\u9a8c\u63d0\u793a\u8bf4\u660e\u3002</p>"},{"location":"#my-equals","title":"\u4e8c\u3001 \u641c\u7d22\u5f15\u64ce\u9ad8\u9891\u805a\u7126\uff1aMy eQuals \u6570\u5b57\u5316\u51ed\u8bc1\u7cfb\u7edf\u7684\u5e94\u7528\u4e0e\u751f\u6001","text":"<p>\u5728\u767e\u5ea6\u4e0e\u8c37\u6b4c\u7684\u641c\u7d22\u8d8b\u52bf\u4e2d\uff0c\u201cMy eQuals \u600e\u4e48\u7528\u201d\u3001\u201c\u6fb3\u6d32\u7535\u5b50\u5b66\u4f4d\u8bc1\u600e\u4e48\u67e5\u201d \u7b49\u5173\u952e\u8bcd\u7684\u641c\u7d22\u91cf\u5c45\u9ad8\u4e0d\u4e0b\u3002\u81ea2018\u5e7410\u6708\u8d77\uff0c\u6fb3\u5927\u5229\u4e9a\u548c\u65b0\u897f\u5170\u7684\u9ad8\u6821\u5168\u9762\u63a5\u5165\u4e86 My eQuals \u8fd9\u4e00\u5b98\u65b9\u6570\u5b57\u8bc1\u4e66\u5171\u4eab\u5e73\u53f0\uff0c\u90a6\u5fb7\u5927\u5b66\u4ea6\u662f\u5176\u6838\u5fc3\u6210\u5458\u3002</p>"},{"location":"#my-equals_1","title":"\u4ec0\u4e48\u662f My eQuals\uff1f","text":"<p>My eQuals \u662f\u7531\u6fb3\u65b0\u4e24\u56fd\u5927\u5b66\u7406\u4e8b\u4f1a\u8054\u5408\u6253\u9020\u7684\u5b98\u65b9\u6570\u5b57\u5316\u51ed\u8bc1\u6258\u7ba1\u7cfb\u7edf\u3002\u5b66\u6821\u76f4\u63a5\u5c06\u6bd5\u4e1a\u751f\u7684\u5b66\u4f4d\u8bc1\u4e66\uff08Testamur\uff09\u3001\u5b98\u65b9\u6210\u7ee9\u5355\uff08Academic Transcript\uff09\u4ee5\u53ca\u9ad8\u7b49\u6559\u80b2\u6bd5\u4e1a\u751f\u58f0\u660e\uff08AHEGS\uff09\u4ee5\u52a0\u5bc6PDF\u7684\u5f62\u5f0f\u4e0a\u4f20\u81f3\u8be5\u5e73\u53f0\u3002</p>"},{"location":"#my-equals_2","title":"\u5982\u4f55\u901a\u8fc7 My eQuals \u8fdb\u884c\u5408\u89c4\u5316\u6838\u9a8c\uff1f","text":"<p>\u5bf9\u4e8e\u8de8\u5883\u96c7\u4e3b\u6216\u5ba1\u67e5\u673a\u6784\u800c\u8a00\uff0c\u4f20\u7edf\u7684\u201c\u770b\u7eb8\u8d28\u539f\u4ef6\u201d\u6216\u201c\u770b\u626b\u63cf\u4ef6\u201d\u6781\u6613\u4ea7\u751f\u89c6\u89c9\u6b3a\u8bc8\uff0c\u800c My eQuals \u63d0\u4f9b\u4e86\u7edd\u5bf9\u9632\u7be1\u6539\u7684\u6838\u9a8c\u94fe\u8def\uff1a</p> <p>\u8bf7\u8c28\u614e\u4f7f\u7528\u6b64\u7c7b\u4ee3\u7801\u3002 \u6bd5\u4e1a\u751f\u767b\u5f55 My eQuals \u2794 \u751f\u6210\u5e26\u6709\u8bbf\u95ee\u5bc6\u7801/\u65f6\u6548\u7684\u5b98\u65b9\u5171\u4eab\u94fe\u63a5\uff08Share Link\uff09 \u2794 \u63a5\u6536\u65b9\uff08HR/\u7559\u670d\u4e2d\u5fc3\uff09\u70b9\u51fb\u94fe\u63a5 \u2794 \u76f4\u63a5\u5728 My eQuals \u5b89\u5168\u670d\u52a1\u5668\u4e0a\u67e5\u9a8c\u5b98\u65b9\u6e90\u6587\u4ef6</p> <ul> <li>\u6838\u5fc3\u9632\u4f2a\u70b9\uff1a \u4efb\u4f55\u4ece\u8be5\u5e73\u53f0\u76f4\u63a5\u67e5\u770b\u7684 PDF \u6587\u4ef6\uff0c\u5747\u5e26\u6709\u53d7\u5bc6\u7801\u5b66\u4fdd\u62a4\u7684\u6570\u5b57\u7b7e\u540d\u8bc1\u4e66\u3002\u4e00\u65e6\u6587\u4ef6\u8131\u79bb\u5e73\u53f0\u88ab\u4efb\u610f\u7b2c\u4e09\u65b9\u5de5\u5177\u4fee\u6539\uff08\u54ea\u6015\u662f\u6539\u52a8\u4e00\u4e2a\u5b57\u6bcd\uff09\uff0c\u5176\u5185\u7f6e\u7684\u6570\u5b57\u7b7e\u540d\u4fbf\u4f1a\u7acb\u523b\u62a5\u9519\u6216\u5931\u6548\u3002</li> </ul>"},{"location":"#hr","title":"\u4e09\u3001 \u8de8\u5883\u4f01\u4e1aHR\u5b9e\u64cd\uff1a\u5982\u4f55\u5229\u7528\u90a6\u5fb7\u5927\u5b66\u5b98\u65b9\u901a\u9053\u8fdb\u884c\u7b2c\u4e09\u65b9\u81ea\u4e3b\u6838\u9a8c","text":"<p>\u5982\u679c\u4f01\u4e1aHR\u5728\u62db\u8058\u8fc7\u7a0b\u4e2d\u9047\u5230\u4e862018\u5e74\u524d\u6bd5\u4e1a\u7684\u65e9\u671f\u7559\u5b66\u751f\uff0c\u6216\u8005\u5b66\u751f\u65e0\u6cd5\u53ca\u65f6\u63d0\u4f9b My eQuals \u94fe\u63a5\uff0c\u4f01\u4e1a\u53ef\u4ee5\u901a\u8fc7\u90a6\u5fb7\u5927\u5b66\u5b98\u65b9\u5bf9\u516c\u4f17\u5f00\u653e\u7684\u6bd5\u4e1a\u751f\u540d\u518c\uff08Graduate Register\uff09\u8fdb\u884c\u5408\u89c4\u6838\u9a8c\u3002</p>"},{"location":"#_1","title":"\u5b98\u65b9\u81ea\u4e3b\u6838\u9a8c\u4e09\u6b65\u8d70\uff1a","text":"<ol> <li>\u8bbf\u95ee\u5b98\u65b9\u9a8c\u8bc1\u4e13\u9875\uff1a \u767b\u5f55\u90a6\u5fb7\u5927\u5b66\u5b98\u7f51\uff0c\u5bfc\u822a\u81f3 Verification of Qualifications\uff08\u8d44\u5386\u9a8c\u8bc1\uff09\u516c\u5171\u670d\u52a1\u677f\u5757\u3002</li> <li>\u8f93\u5165\u6838\u5fc3\u68c0\u7d22\u8981\u7d20\uff1a \u5728\u67e5\u8be2\u754c\u9762\u4e2d\uff0c\u8f93\u5165\u6bd5\u4e1a\u751f\u7684\u6cd5\u5b9a\u59d3\u6c0f\uff08Exact Surname\uff09\u4ee5\u53ca\u5b66\u4f4d\u7684\u6388\u4e88\u5e74\u4efd\uff08Conferral Year\uff09\u3002\u6ce8\u610f\uff1a\u8f93\u5165\u7684\u59d3\u6c0f\u5fc5\u987b\u4e0e\u5b66\u4f4d\u8bc1\u4e0a\u7684\u62fc\u5199\u4ee5\u53ca\u62a4\u7167\u82f1\u6587\u5b8c\u5168\u4e00\u81f4\u3002</li> <li>\u8bfb\u53d6\u7cfb\u7edf\u5bf9\u9f50\u6570\u636e\uff1a \u7cfb\u7edf\u4f1a\u76f4\u63a5\u4ece\u90a6\u5fb7\u5927\u5b66\u4e2d\u592e\u6570\u636e\u5e93\u4e2d\u8c03\u53d6\u5e76\u663e\u793a\u5339\u914d\u4fe1\u606f\uff0c\u5305\u62ec\uff1a\u5b66\u751f\u5168\u540d\u3001\u6240\u83b7\u5b66\u4f4d\u5168\u79f0\u3001\u8363\u8a89\u7b49\u7ea7\uff08\u5982\u6709\uff09\u4ee5\u53ca\u786e\u5207\u7684\u6bd5\u4e1a\u5178\u793c/\u6388\u4e88\u65e5\u671f\uff08Conferral Date\uff09\u3002</li> </ol>"},{"location":"#_2","title":"\u4eba\u5de5\u5e72\u9884\u8de8\u5883\u80cc\u8c03\uff08\u9488\u5bf9\u9690\u79c1\u4fdd\u62a4\u9650\u5236\uff09","text":"<p>\u7531\u4e8e\u90e8\u5206\u6bd5\u4e1a\u751f\u5728\u6821\u671f\u95f4\u7b7e\u7f72\u4e86\u9690\u79c1\u4fdd\u62a4\u534f\u8bae\uff0c\u6216\u8005\u5176\u8d26\u6237\u7531\u4e8e\u5386\u53f2\u56fe\u4e66\u9986\u6b20\u8d39\u3001\u5b66\u8d39\u5c3e\u6b3e\u672a\u6e05\uff08Sanctions\uff09\u800c\u88ab\u7cfb\u7edf\u6682\u65f6\u9501\u5b9a\uff0c\u516c\u5171\u540d\u518c\u53ef\u80fd\u4f1a\u51fa\u73b0\u201c\u67e5\u65e0\u6b64\u4eba\u201d\u7684\u60c5\u51b5\u3002 * \u5408\u89c4\u64cd\u4f5c\uff1a HR\u5e94\u8981\u6c42\u5019\u9009\u4eba\u586b\u5199\u5e76\u7b7e\u7f72\u90a6\u5fb7\u5927\u5b66\u4e13\u7528\u7684\u300aQualification Verification Form\u300b\uff08\u7b2c\u4e09\u65b9\u4fe1\u606f\u62ab\u9732\u6388\u6743\u4e66\uff09\u3002 * \u5b98\u65b9\u5bf9\u63a5\u90ae\u7bb1\uff1a \u5c06\u6388\u6743\u4e66\u8fde\u540c\u8bc1\u4e66\u626b\u63cf\u4ef6\u4e00\u5e76\u53d1\u9001\u81f3\u90a6\u5fb7\u5927\u5b66\u6559\u52a1\u652f\u6301\u90ae\u7bb1\uff1a<code>studentassist@bond.edu.au</code>\u3002\u5b98\u65b9\u4eba\u5de5\u56e2\u961f\u901a\u5e38\u4f1a\u57283-5\u4e2a\u5de5\u4f5c\u65e5\u5185\u7ed9\u4f01\u4e1a\u51fa\u5177\u6b63\u5f0f\u7684\u80cc\u8c03\u786e\u8ba4\u56de\u51fd\u3002</p>"},{"location":"#cscse","title":"\u56db\u3001 \u4e2d\u56fd\u56fd\u5883\u5408\u89c4\u5316\u51c6\u5165\uff1a\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\uff08CSCSE\uff09\u8ba4\u8bc1\u8be6\u89e3","text":"<p>\u5bf9\u4e8e\u56de\u56fd\u53d1\u5c55\u7684\u90a6\u5fb7\u5927\u5b66\u6bd5\u4e1a\u751f\u800c\u8a00\uff0c\u83b7\u5f97\u7eb8\u8d28\u8bc1\u4e66\u4e0e\u7535\u5b50\u8bc1\u4e66\u4ec5\u5b8c\u6210\u4e86\u5b66\u672f\u5c42\u9762\u7684\u8de8\u56fd\u4ea4\u63a5\u3002\u82e5\u60f3\u8fdb\u5165\u4e2d\u56fd\u5185\u5730\u7684\u56fd\u4f01\u3001\u4e8b\u4e1a\u5355\u4f4d\u3001\u62a5\u8003\u516c\u52a1\u5458\uff0c\u6216\u4eab\u53d7\u4e00\u7ebf\u57ce\u5e02\u7684\u7559\u5b66\u56de\u56fd\u4eba\u5458\u843d\u6237\u4e0e\u8d2d\u8f66\u653f\u7b56\uff0c\u4e2d\u56fd\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\uff08CSCSE\uff09\u7684\u56fd\uff08\u5883\uff09\u5916\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1\u4e66\u662f\u552f\u4e00\u7684\u6cd5\u5b9a\u5408\u89c4\u51c6\u5165\u51ed\u8bc1\u3002</p> <p>\u7559\u670d\u4e2d\u5fc3\u7684\u5ba1\u6838\u5e76\u975e\u7b80\u5355\u7684\u201c\u770b\u56fe\u8bc6\u8bc1\u201d\uff0c\u800c\u662f\u901a\u8fc7\u4e2d\u6fb3\u4e24\u56fd\u653f\u5e9c\u95f4\u7684\u6559\u80b2\u5408\u4f5c\u6846\u67b6\uff0c\u5bf9\u5b66\u751f\u7684\u5c31\u8bfb\u771f\u5b9e\u6027\u3001\u51fa\u5165\u5883\u8bb0\u5f55\u5408\u7406\u6027\u8fdb\u884c\u7a7f\u900f\u5f0f\u8c03\u53d6\u3002</p>"},{"location":"#1_1","title":"1. \u7559\u670d\u8ba4\u8bc1\u6838\u5fc3\u6750\u6599\u6e05\u5355\uff08\u5168\u6570\u5b57\u5316\u626b\u63cf\u4ef6\u63d0\u4ea4\uff09","text":"\u6750\u6599\u540d\u79f0 \u683c\u5f0f\u4e0e\u8d28\u91cf\u8981\u6c42 \u5907\u6ce8\u8bf4\u660e \u5b66\u4f4d\u8bc1\u4e66\uff08Testamur\uff09 \u5fc5\u987b\u4e3a\u539f\u4ef6\u7684\u9ad8\u6e05\u6670\u5ea6\u5f69\u8272\u626b\u63cfPDF/JPG \u9700\u5b8c\u6574\u5305\u542b\u56db\u89d2\uff0c\u8fb9\u7f18\u65e0\u906e\u6321\uff0c\u5efa\u8bae\u76f4\u63a5\u4f7f\u7528 My eQuals \u5bfc\u51fa\u7684\u539f\u7248\u6570\u5b57\u5316PDF\u3002 \u5b98\u65b9\u5b8c\u6574\u6210\u7ee9\u5355 \u9ad8\u6e05\u6670\u5ea6\u5f69\u8272\u626b\u63cf\u4ef6 \u867d\u7136\u4e3b\u8981\u8ba4\u8bc1\u5b66\u4f4d\u8bc1\uff0c\u4f46\u6210\u7ee9\u5355\u662f\u7559\u670d\u4e2d\u5fc3\u6838\u5bf9\u4fee\u8bfb\u5b66\u5206\u3001\u5c31\u8bfb\u5b66\u5236\u7684\u91cd\u8981\u8f85\u52a9\u4f9d\u636e\u3002 \u7533\u8bf7\u4eba\u62a4\u7167\u53ca\u51fa\u5165\u5883\u8bb0\u5f55 \u5305\u542b\u57fa\u672c\u4fe1\u606f\u9875\u3001\u7559\u5b66\u671f\u95f4\u6240\u6709\u7b7e\u8bc1\u9875\u53ca\u76d6\u7ae0\u9875 \u9700\u767b\u5f55\u201c\u56fd\u5bb6\u79fb\u6c11\u7ba1\u7406\u5c40\u201d\u5c0f\u7a0b\u5e8f\uff0c\u5bfc\u51fa\u7559\u5b66\u671f\u95f4\u5b8c\u6574\u7684\u51fa\u5165\u5883\u8bb0\u5f55PDF\u7535\u5b50\u7248\u3002 \u4e24\u5bf8\u84dd\u5e95\u8bc1\u4ef6\u7167 \u6b63\u89c4\u8bc1\u4ef6\u7167\u7535\u5b50\u7248 \u7528\u4e8e\u6700\u7ec8\u8ba4\u8bc1\u4e66\u7cfb\u7edf\u5185\u5efa\u6863\u3002 \u6838\u9a8c\u6388\u6743\u58f0\u660e\uff08Authorization Letter\uff09 \u5728\u7559\u670d\u4e2d\u5fc3\u5b98\u7f51\u4e0b\u8f7d\u6807\u51c6\u6a21\u677f\u5e76\u624b\u5199\u7b7e\u5b57 \u6388\u6743\u4e2d\u56fd\u7559\u670d\u4e2d\u5fc3\u76f4\u63a5\u5411\u6fb3\u5927\u5229\u4e9a\u90a6\u5fb7\u5927\u5b66\u53d1\u8d77\u5b66\u7c4d\u4e0e\u80cc\u666f\u6838\u67e5\u3002"},{"location":"#2","title":"2. \u7559\u670d\u4e2d\u5fc3\u9488\u5bf9\u90a6\u5fb7\u5927\u5b66\u7684\u6838\u9a8c\u7a7f\u900f\u94fe\u8def","text":"<p>\u5728\u4e2d\u56fd\u7559\u670d\u4e2d\u5fc3\u6536\u5230\u5b66\u751f\u7684\u5728\u7ebf\u7533\u8bf7\u540e\uff0c\u5ba1\u6838\u7cfb\u7edf\u4f1a\u542f\u52a8\u95ed\u73af\u5f0f\u7684\u8de8\u5883\u6838\u9a8c\uff1a</p>"},{"location":"#3_1","title":"3. \u7279\u522b\u5408\u89c4\u63d0\u9192\uff1a\u51fa\u5165\u5883\u5929\u6570\u4e0e\u7f51\u8bfe\u5408\u89c4\u6027","text":"<ul> <li>\u51fa\u5165\u5883\u5929\u6570\u5ba1\u67e5\uff1a \u90a6\u5fb7\u5927\u5b66\u4ee5\u201c\u4e00\u5e74\u4e09\u5b66\u671f\uff08Trimester\uff09\u201d\u7684\u9ad8\u5f3a\u5ea6\u5feb\u8282\u594f\u5b66\u5236\u8457\u79f0\uff0c\u6b63\u5e38\u60c5\u51b5\u4e0b\u5b66\u751f\u5728\u6fb3\u6d32\u672c\u571f\u7684\u505c\u7559\u65f6\u95f4\u5e94\u4e0e\u5b66\u6821\u7684\u6559\u5b66\u5468\u9ad8\u5ea6\u5951\u5408\u3002\u7559\u670d\u4e2d\u5fc3\u4f1a\u4e25\u683c\u6bd4\u5bf9\u51fa\u5165\u5883\u8bb0\u5f55\uff0c\u82e5\u53d1\u73b0\u5b66\u751f\u5728\u6559\u5b66\u671f\u5185\u957f\u671f\u6ede\u7559\u56fd\u5185\uff0c\u5c06\u4f1a\u88ab\u8981\u6c42\u8865\u5145\u63d0\u4f9b\u201c\u7f51\u8bfe\u8bc1\u660e\u201d\u6216\u201c\u5b66\u6821\u5b98\u65b9\u7f51\u8bfe\u6279\u51c6\u51fd\u201d\u3002</li> <li>\u6587\u51ed\u4ee3\u529e\u4e0e\u4f2a\u9020\u9ed1\u540d\u5355\u8b66\u544a\uff1a \u7559\u670d\u4e2d\u5fc3\u8fd1\u5e74\u6765\u5df2\u4e0a\u7ebf\u4e86\u4e25\u5389\u7684\u5931\u4fe1\u60e9\u6212\u673a\u5236\u3002\u4efb\u4f55\u4f7f\u7528\u4f2a\u9020\u5168\u606f\u6807\u3001\u4fee\u6539\u540d\u5b57\u7684\u201c\u5047\u6587\u51ed\u201d\u5c1d\u8bd5\u7792\u5929\u8fc7\u6d77\u7684\u7533\u8bf7\u8005\uff0c\u5176\u4e2a\u4eba\u4fe1\u606f\u5c06\u88ab\u6c38\u4e45\u516c\u793a\u4e8e\u4e2d\u56fd\u7559\u5b66\u7f51\u7684\u201c\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1\u6d89\u5047\u884c\u4e3a\u516c\u793a\u4e13\u680f\u201d\uff0c\u5e76\u901a\u62a5\u7ed9\u7528\u4eba\u5355\u4f4d\uff0c\u76f4\u63a5\u5f71\u54cd\u4e2a\u4eba\u793e\u4f1a\u4fe1\u7528\u4f53\u7cfb\u3002</li> </ul>"},{"location":"#_3","title":"\u4e94\u3001 \u603b\u7ed3\u4e0e\u5408\u89c4\u5efa\u8bae","text":"<p>\u6fb3\u5927\u5229\u4e9a\u90a6\u5fb7\u5927\u5b66\u7684\u5b66\u4f4d\u8bc1\u4e66\u51ed\u501f\u5176\u7ecf\u5178\u7684\u90a6\u5fb7\u84dd\u89c6\u89c9\u6392\u7248\u3001\u9ad8\u7cbe\u5ea6\u7684\u5f69\u8272\u76fe\u5fbd\u3001\u72ec\u7279\u7684\u7ea2\u8272\u706b\u6f06\u94a2\u5370\u3001\u52a8\u6001\u5168\u606f\u9632\u4f2a\u6807\u7b7e\u4ee5\u53ca\u5e95\u5c42 My eQuals \u5bc6\u7801\u5b66\u6570\u5b57\u7b7e\u540d\uff0c\u6784\u5efa\u4e86\u6781\u4e3a\u4e25\u5bc6\u7684\u7269\u7406\u4e0e\u6570\u5b57\u9632\u4f2a\u77e9\u9635\u3002</p> <p>\u65e0\u8bba\u662f\u56fd\u5185\u4f01\u4e1a\u5728\u7b5b\u9009\u6d77\u5916\u4eba\u624d\uff0c\u8fd8\u662f\u7559\u5b66\u751f\u5728\u529e\u7406\u5f52\u56fd\u5408\u89c4\u51c6\u5165\u624b\u7eed\uff0c\u5584\u7528 My eQuals \u5b98\u65b9\u6570\u5b57\u5171\u4eab \u4e0e \u7559\u670d\u4e2d\u5fc3\u5408\u89c4\u8ba4\u8bc1 \u8fd9\u4e24\u6761\u6b63\u89c4\u6e20\u9053\uff0c\u5373\u53ef\u5f7b\u5e95\u675c\u7edd\u6587\u51ed\u6b3a\u8bc8\uff0c\u786e\u4fdd\u8de8\u56fd\u6559\u80b2\u6210\u679c\u5728\u56fd\u5883\u5185\u7684\u5408\u6cd5\u6027\u4e0e\u6743\u5a01\u6027\u3002</p>"}]}